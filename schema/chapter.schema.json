{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MonsieurM2/wiki-LOTM/schema/chapter.schema.json",
  "title": "Chapter data file — canonical store",
  "description": "One file per chapter, 0001 to 1394. Evidence is stored here exactly once; derived fichés and the graph reference it by id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "book", "number", "title", "text", "status", "evidence", "mentions", "events", "relations"],
  "properties": {
    "id": { "type": "string", "pattern": "^C\\d{4}$" },
    "book": { "type": "integer", "minimum": 1, "maximum": 8 },
    "number": { "type": "integer", "minimum": 1, "maximum": 1394 },
    "title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "status": { "enum": ["extracted", "verified", "disputed", "excluded"] },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "mentions": { "type": "array", "items": { "$ref": "#/$defs/mention" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }
  },
  "$defs": {
    "entityId": { "type": "string", "pattern": "^E-[a-z0-9]+(?:-[a-z0-9]+)*-[a-f0-9]{6}$" },
    "evidenceId": { "type": "string", "pattern": "^EV-\\d{4}-\\d{3}$" },
    "eventId": { "type": "string", "pattern": "^EVT-\\d{4}-\\d{3}$" },
    "relationType": {
      "enum": [
        "APPEARS_IN", "CONTAINS_MENTION",
        "PARTICIPATED_IN", "HAS_PARTICIPANT",
        "OCCURS_IN", "CONTAINS_EVENT",
        "MEMBER_OF", "HAS_MEMBER",
        "LOCATED_IN", "CONTAINS_LOCATION",
        "OWNS", "OWNED_BY",
        "USES", "USED_BY",
        "FOLLOWS_PATHWAY", "HAS_FOLLOWER",
        "HOLDS_SEQUENCE", "HELD_BY",
        "RELATED_TO",
        "OPPOSES", "OPPOSED_BY",
        "MENTOR_OF", "MENTORED_BY"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "book", "chapter", "chapter_title", "quote", "verifier", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/evidenceId" },
        "book": { "type": "integer", "minimum": 1, "maximum": 8 },
        "chapter": { "type": "integer", "minimum": 1, "maximum": 1394 },
        "chapter_title": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "offsets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        },
        "verifier": { "type": "string", "minLength": 1 },
        "status": { "enum": ["confirmed", "disputed", "excluded"] }
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity", "evidence_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^MEN-\\d{4}-\\d{3}$" },
        "entity": { "$ref": "#/$defs/entityId" },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceId" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "participants", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/eventId" },
        "label": { "type": "string", "minLength": 1 },
        "participants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entityId" } },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceId" } }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "target", "inverse", "evidence_ids"],
      "properties": {
        "type": { "$ref": "#/$defs/relationType" },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "inverse": { "$ref": "#/$defs/relationType" },
        "label": { "type": "string", "minLength": 1 },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceId" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "RELATED_TO" } } },
          "then": { "required": ["label"] }
        }
      ]
    }
  }
}

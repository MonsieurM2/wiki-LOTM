---
import Base from '../layouts/Base.astro';
import SpoilerVeil from '../components/SpoilerVeil';
import { escapeHtml, loadChapters } from '../lib/data';

const chapters = loadChapters();
const ranked = chapters
  .map((c) => ({ chapter: c, count: c.relations.length }))
  .filter((r) => r.count > 0)
  .sort((a, b) => b.count - a.count);
const selected = ranked[0]?.chapter;

const nodes = selected
  ? [...new Set(selected.relations.flatMap((r) => [r.source, r.target]))]
      .map((id, i) => ({ id, label: selected.entities.find((e) => e.id === id)?.canonical_name ?? id, i }))
  : [];
const byId = new Map(nodes.map((n) => [n.id, n]));
const edges = selected
  ? selected.relations
      .map((r) => ({ from: byId.get(r.source), to: byId.get(r.target), type: r.type }))
      .filter((e) => e.from && e.to)
  : [];
const point = (i: number) => {
  const angle = (2 * Math.PI * i) / Math.max(nodes.length, 1) - Math.PI / 2;
  return { x: 400 + 280 * Math.cos(angle), y: 300 + 210 * Math.sin(angle) };
};
---

<Base title="Graph" kicker="[ Link ledger · chapter-scoped ]"
      lede="A chapter is a constellation. Its edges are typed, and every edge has a testimony."
      current="Graph">
  <p slot="context">{nodes.length} nodes on file</p>

  <div class="graph-page">
    {selected ? (
      <Fragment>
        <p class="source">Selected: chapter {String(selected.number).padStart(4, '0')} — {escapeHtml(selected.title)}</p>
        <svg viewBox="0 0 800 600" role="img" aria-label={`Typed relations in chapter ${selected.number}`}>
          <g stroke="rgba(168,154,122,.42)" stroke-width="1">
            {edges.map((e) => {
              const a = point(e.from!.i); const b = point(e.to!.i);
              return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />;
            })}
          </g>
          <g>
            {nodes.map((n) => {
              const p = point(n.i);
              return (
                <g>
                  <circle cx={p.x} cy={p.y} r="6" fill="#DCCFB0" stroke="#B04338" stroke-width="2" />
                  <text x={p.x + 10} y={p.y + 4} fill="#DCCFB0" font-size="12" font-family="monospace">{n.label}</text>
                </g>
              );
            })}
          </g>
        </svg>
      </Fragment>
    ) : <p>No typed relations have been generated yet.</p>}

    <h2>Files with edges</h2>
    <ol class="appearances">
      {ranked.map((r) => (
        <li><span class="ref">CHAPTER {String(r.chapter.number).padStart(4, '0')}</span> — {escapeHtml(r.chapter.title)} · {r.count} edges</li>
      ))}
    </ol>
  </div>

  <p class="ledger">{edges.length} typed relations · static SVG, no script</p>
  <SpoilerVeil client:load />
</Base>
